# Set the final HTTPS URL before a production deployment.
PUBLIC_ORIGIN=http://localhost:3100
HOST=127.0.0.1
PORT=3100

# Omit all three settings to run the local sample publication.
# Use the blog-specific database login and your Supabase publishable key.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional operator contact shown in About, Privacy, and Editorial Policy.
CONTACT_EMAIL=
